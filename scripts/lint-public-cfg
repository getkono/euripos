#!/usr/bin/env bash
# Fails when the facade crate's public API is not the same on every supported
# platform and feature set: the observable effect of a `cfg(target_os)`,
# `cfg(feature)` or other `cfg` on a public item (docs/design/api.md, "Static
# gates"). It renders the API with `cargo public-api` once per supported OS and
# feature set and diffs each render against the first.
#
# Rendering runs every dependency's build script for the target, and a build
# script that compiles C needs that target's C toolchain. Each OS is therefore
# rendered on the host that has its toolchain, and CI diffs the renders of every
# host in one job:
#
#   lint-public-cfg              render this host's OSes, then diff them
#   lint-public-cfg render       render this host's OSes into $out
#   lint-public-cfg diff DIR...  diff every render found under DIR..., requiring
#                                exactly one per supported OS and feature set
#
# One target per supported OS: a `cfg` that differs only by architecture, or
# that holds on every target rendered, is not observable here.
set -euo pipefail

oses=(linux android macos ios windows)
feature_sets=("" "--no-default-features" "--all-features")
out="${CARGO_TARGET_DIR:-target}/public-cfg"

# host_oses: the supported OSes this host renders.
host_oses() {
  case "$(uname -s)" in
    Linux) echo linux android ;;
    Darwin) echo macos ios ;;
    MINGW* | MSYS* | CYGWIN*) echo windows ;;
    *)
      echo "error: no supported OS renders on $(uname -s)" >&2
      return 1
      ;;
  esac
}

# target_of OS: the target triple OS is rendered for. Linux and Windows render
# for the host's own triple, so the host's C compiler builds for it.
target_of() {
  local host
  case "$1" in
    linux | windows)
      host="$(rustc -vV | sed -n 's/^host: //p')"
      case "$1:$host" in
        linux:*-linux-gnu | windows:*-windows-msvc) echo "$host" ;;
        *)
          echo "error: $1 renders on a $1 host, not $host" >&2
          return 1
          ;;
      esac
      ;;
    android) echo aarch64-linux-android ;;
    macos) echo aarch64-apple-darwin ;;
    ios) echo aarch64-apple-ios ;;
  esac
}

# file_of OS FEATURES: the render's file name.
file_of() {
  printf '%s%s.txt\n' "$1" "${2//[- ]/_}"
}

# android_toolchain: point the `cc` crate at the Android NDK's clang and ar, so
# build scripts that compile C build for Android. Without an NDK, a dependency
# with C fails to render for Android.
android_toolchain() {
  local api="${EURIPOS_ANDROID_API:?set in mise.toml}"
  local ndk="${ANDROID_NDK_HOME:-${ANDROID_NDK_LATEST_HOME:-${ANDROID_NDK_ROOT:-}}}"
  if [ -z "$ndk" ] && [ -d "${ANDROID_HOME:-}/ndk" ]; then
    ndk="$(find "$ANDROID_HOME/ndk" -mindepth 1 -maxdepth 1 -type d | sort -V | tail -n 1)"
  fi
  if [ -z "$ndk" ]; then
    echo "warning: no Android NDK (set ANDROID_NDK_HOME); android renders only while no dependency compiles C" >&2
    return 0
  fi
  local bin
  bin="$(find "$ndk/toolchains/llvm/prebuilt" -mindepth 2 -maxdepth 2 -type d -name bin | head -n 1)"
  if [ -z "$bin" ]; then
    echo "error: $ndk holds no toolchains/llvm/prebuilt/*/bin" >&2
    return 1
  fi
  export CC_aarch64_linux_android="${CC_aarch64_linux_android:-$bin/aarch64-linux-android$api-clang}"
  export AR_aarch64_linux_android="${AR_aarch64_linux_android:-$bin/llvm-ar}"
}

# render: render each of this host's OSes and feature sets into $out.
render() {
  local toolchain="${EURIPOS_API_NIGHTLY:?set in mise.toml}"
  local hosts os target features
  hosts="$(host_oses)"
  rm -rf "$out"
  mkdir -p "$out"
  rustup toolchain install "$toolchain" --profile minimal --no-self-update
  for os in $hosts; do
    target="$(target_of "$os")"
    rustup target add --toolchain "$toolchain" "$target"
    if [ "$os" = android ]; then android_toolchain; fi
    for features in "${feature_sets[@]}"; do
      echo "rendering $os ($target)${features:+ $features}" >&2
      # shellcheck disable=SC2086 # `features` is one flag or none.
      cargo "+$toolchain" public-api -p euripos --simplified --target "$target" $features \
        > "$out/$(file_of "$os" "$features")"
    done
  done
}

# compare "OS..." DIR...: diff the render of each OS listed and each feature set
# against the first, finding each render under DIR...; a render that is missing
# or found twice fails.
compare() {
  local wanted="$1" os features name file matches count reference="" reference_name="" failed=0
  shift
  for os in $wanted; do
    for features in "${feature_sets[@]}"; do
      name="$os${features:+ $features}"
      matches="$(find "$@" -type f -name "$(file_of "$os" "$features")")"
      count="$(printf '%s' "$matches" | grep -c '' || true)"
      if [ "$count" -ne 1 ]; then
        echo "error: $count renders of $name under $*; want exactly one" >&2
        failed=1
        continue
      fi
      file="$matches"
      if [ -z "$reference" ]; then
        reference="$file"
        reference_name="$name"
      elif ! diff -u --label "$reference_name" --label "$name" "$reference" "$file"; then
        echo "error: the public API on $name differs from $reference_name" >&2
        failed=1
      fi
    done
  done
  if [ "$failed" -ne 0 ]; then
    echo "error: a public item depends on cfg, or a render is missing; see CONTRIBUTING.md, \"Code layout\"" >&2
    return 1
  fi
  echo "public API identical on $(echo "$wanted" | wc -w | tr -d ' ') OSes ($wanted) x ${#feature_sets[@]} feature sets"
}

case "${1:-}" in
  "")
    hosts="$(host_oses)"
    render
    compare "$hosts" "$out"
    echo "note: this host renders $hosts; CI's api-cfg job diffs the renders of every supported OS"
    ;;
  render) render ;;
  diff)
    shift
    if [ "$#" -eq 0 ]; then
      echo "usage: $0 diff DIR..." >&2
      exit 2
    fi
    compare "${oses[*]}" "$@"
    ;;
  *)
    echo "usage: $0 [render | diff DIR...]" >&2
    exit 2
    ;;
esac
