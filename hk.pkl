amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

// Git hooks: `hk install` once per clone. CI runs the same gates through
// `mise run check` and `mise run commits:check`, so a hook is a shortcut, not
// the gate.

local linters = new Mapping {
    ["cargo_clippy"] = Builtins.cargo_clippy
    ["cargo_fmt"] = Builtins.cargo_fmt
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["check"] {
        steps {
            ...linters
            ["cargo_deny"] = Builtins.cargo_deny
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["commit-msg"] {
        steps {
            ["convco"] {
                check = "convco check --from-stdin --strip < {{commit_msg_file}}"
            }
        }
    }
}
